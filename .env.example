# Database
DATABASE_URL="postgresql://kirkira:kirkira_pass@localhost:5432/kirkira_copyright"

# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# Anthropic API
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-4-7"
LLM_CONFIDENCE_THRESHOLD=0.75

# KECOBO Portal Credentials (institutional)
KECOBO_URL="https://nrr.copyright.go.ke"
KECOBO_USERNAME="kirkira@example.com"
KECOBO_PASSWORD="your-kecobo-password"

# File Storage (local or S3-compatible)
STORAGE_TYPE="local"           # "local" | "s3"
STORAGE_LOCAL_PATH="./uploads"
AWS_BUCKET_NAME=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# JWT Auth
JWT_SECRET="change-this-to-a-strong-random-secret"
JWT_EXPIRES_IN="7d"

# Backend
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Kirkira Copyright Filing"

# Nightly sync cron (default: 2 AM EAT = midnight UTC)
NIGHTLY_SYNC_CRON="0 21 * * *"

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
